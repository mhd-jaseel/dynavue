    "js-cookie": "^3.0.5",
    "lenis": "^1.3.23",
    "lucide-react": "^0.294.0",
    "motion": "^10.16.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.7",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.6.0",
